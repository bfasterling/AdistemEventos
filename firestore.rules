rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Allow read and write to all collections
    // This is required because the application utilizes a synchronized data store
    // that fetches and processes all datasets at startup to power both the
    // simulated mobile app (delegates) and the web backoffice console.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
